import { useState } from "react";
import { createFileRoute } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { supabase } from "@/integrations/supabase/client";
import { INQUIRY_STATUSES, InquiryStatus } from "@/lib/site";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Download, Eye, RefreshCw, Search } from "lucide-react";
import { toast } from "sonner";

export const Route = createFileRoute("/admin/inquiries")({
  component: AdminInquiriesPage,
});

function AdminInquiriesPage() {
  const [filterStatus, setFilterStatus] = useState<string>("all");
  const [searchTerm, setSearchTerm] = useState("");

  const { data: inquiries, refetch, isFetching } = useQuery({
    queryKey: ["admin_inquiries"],
    queryFn: async () => {
      const { data, error } = await supabase
        .from("inquiries")
        .select("*, inquiry_items(*)")
        .order("created_at", { ascending: false });
      if (error) throw error;
      return data;
    },
  });

  const handleStatusChange = async (id: string, newStatus: InquiryStatus) => {
    const { error } = await supabase
      .from("inquiries")
      .update({ status: newStatus })
      .eq("id", id);
    if (error) {
      toast.error("Failed to update status: " + error.message);
    } else {
      toast.success(`Updated status to ${newStatus}`);
      refetch();
    }
  };

  const exportCSV = () => {
    if (!inquiries || inquiries.length === 0) return;
    const headers = ["Reference", "Date", "Customer", "Company", "Phone", "Email", "Status", "Delivery Location"];
    const rows = inquiries.map((iq) => [
      iq.reference_code,
      new Date(iq.created_at).toLocaleDateString(),
      `"${iq.customer_name}"`,
      `"${iq.company_name || ""}"`,
      iq.phone,
      iq.email || "",
      iq.status,
      `"${iq.delivery_location || ""}"`,
    ]);
    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `AS_Traders_Inquiries_${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const filtered = (inquiries || []).filter((iq) => {
    const matchesStatus = filterStatus === "all" || iq.status === filterStatus;
    const matchesSearch =
      iq.customer_name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      iq.company_name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      iq.reference_code?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      iq.phone?.includes(searchTerm);
    return matchesStatus && matchesSearch;
  });

  return (
    <div className="p-6 max-w-7xl mx-auto space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900 font-display">
            Inquiry & RFQ Management
          </h1>
          <p className="text-xs text-slate-500">Track incoming customer quotes and status pipelines.</p>
        </div>
        <div className="flex gap-2">
          <Button variant="outline" size="sm" onClick={() => refetch()} disabled={isFetching}>
            <RefreshCw className={`w-4 h-4 mr-1 ${isFetching ? "animate-spin" : ""}`} /> Refresh
          </Button>
          <Button variant="outline" size="sm" onClick={exportCSV}>
            <Download className="w-4 h-4 mr-1" /> Export CSV
          </Button>
        </div>
      </div>

      {/* Filter bar */}
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1">
          <Search className="w-4 h-4 absolute left-3 top-3 text-slate-400" />
          <input
            type="text"
            placeholder="Search by customer, company, phone, reference..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm bg-white"
          />
        </div>
        <select
          value={filterStatus}
          onChange={(e) => setFilterStatus(e.target.value)}
          className="px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-700"
        >
          <option value="all">All Statuses</option>
          {INQUIRY_STATUSES.map((st) => (
            <option key={st} value={st}>{st}</option>
          ))}
        </select>
      </div>

      {/* Pipeline Table */}
      <div className="bg-white border border-slate-200 rounded-xl overflow-hidden">
        <table className="w-full text-left text-sm text-slate-700">
          <thead className="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600 uppercase">
            <tr>
              <th className="py-3 px-4">Ref Code</th>
              <th className="py-3 px-4">Customer / Company</th>
              <th className="py-3 px-4">Contact</th>
              <th className="py-3 px-4">Items</th>
              <th className="py-3 px-4">Status</th>
              <th className="py-3 px-4">Date</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100">
            {filtered.length === 0 ? (
              <tr>
                <td colSpan={6} className="py-8 text-center text-slate-400 text-xs">
                  No inquiries found matching criteria.
                </td>
              </tr>
            ) : (
              filtered.map((iq) => (
                <tr key={iq.id} className="hover:bg-slate-50/60">
                  <td className="py-3 px-4 font-mono text-xs font-bold text-blue-900">
                    {iq.reference_code}
                  </td>
                  <td className="py-3 px-4">
                    <div className="font-semibold text-slate-900">{iq.customer_name}</div>
                    <div className="text-xs text-slate-500">{iq.company_name || "Individual / Direct"}</div>
                  </td>
                  <td className="py-3 px-4 text-xs">
                    <div>{iq.phone}</div>
                    <div className="text-slate-400">{iq.email || "No email"}</div>
                  </td>
                  <td className="py-3 px-4 text-xs">
                    <span className="font-medium text-slate-800">
                      {iq.inquiry_items?.length || 0} items
                    </span>
                  </td>
                  <td className="py-3 px-4">
                    <select
                      value={iq.status}
                      onChange={(e) => handleStatusChange(iq.id, e.target.value as InquiryStatus)}
                      className="text-xs font-medium border border-slate-200 rounded px-2 py-1 bg-white"
                    >
                      {INQUIRY_STATUSES.map((st) => (
                        <option key={st} value={st}>{st}</option>
                      ))}
                    </select>
                  </td>
                  <td className="py-3 px-4 text-xs text-slate-500">
                    {new Date(iq.created_at).toLocaleDateString()}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
